@thesis{itpln:priyaningrum_sistem_2016,
title = {Sistem Informasi Penelitian Internal Dosen Pada Lembaga Penelitian dan Pengabdian Kepada Masyarakat (LPPM) STT-PLN},
author = {Priyaningrum, Siska and Cahyaningtyas, Rizqia and Arianto, Rakhmat},
url = {https://repository.itpln.ac.id/id/eprint/4795},
year = {2016},
abstract = {Pada saat ini proses pengajuan proposal penelitian internal, pengumpulan laporan akhir, pengumpulan luaran hasil penelitian masih menggunakan cara manual pada LPPM STT-PLN, sehingga memungkinkan terjadinya tingkat kesalahan yang tinggi. Penelitian ini bertujuan untuk membangun sebuah sistem informasi penelitian internal dosen berbasis website untuk mengelola data penelitian. Metode pengembangan sistem yang diterapkan pada penelitian ini adalah metode waterfall. Hasil dari penelitian ini berupa sistem informasi penelitian internal dosen yang menggunakan bahasa pemrograman PHP dan basis data MySQL yang dapat menunjang kinerja LPPM dalam mengelola data kegiatan penelitian internal dosen dan memudahkan dosen dalam proses pengajuan proposal penelitian internal, pengumpulan laporan akhir dan pengumpulan luaran hasil penelitian.},
keywords = {Internal Lecturer Research Information System, Waterfall, PHP, MySQL, Research and Subservience Department STT-PLN Sistem informasi penelitian internal dosen, Waterfall, PHP, MySQL, LPPM STT-PLN Jakarta}
}